# Copy to .env and fill in. Git ignores .env, so nothing here reaches the repo.
# The CLIs load it themselves (node --env-file-if-exists=.env) and dbmate reads
# it natively. Vitest does not: a database test stays opt-in per shell.

# dbmate, psql, and every CLI that opens a pool
DATABASE_URL=postgres://postgres:mineral@127.0.0.1:55432/mineral?sslmode=disable

# Model gateway. Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional attribution for the OpenRouter dashboard, sent as HTTP-Referer.
# Nothing is sent when this is empty.
OPENROUTER_SITE_URL=

# SEC refuses anonymous traffic. Their documented shape is a name and a real
# contact address; a URL is not accepted in place of one.
SEC_USER_AGENT=

# Where pnpm calc looks for the analytics service.
ANALYTICS_URL=http://127.0.0.1:8000

# The web app. BETTER_AUTH_SECRET signs session cookies; generate one with
# `openssl rand -base64 32`. Without it Better Auth refuses to start.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Single-operator mode. The account exists to stop an anonymous visitor
# spending money on model calls, so on a machine with one person at it there
# is nothing to sign in to. Set this to that person's address and the app
# skips the session entirely, attributing runs to them; leave it empty and
# Better Auth guards the run trigger as before. Never set it on a host anyone
# else can reach: it is an open door by design.
MINERAL_LOCAL_OPERATOR=
