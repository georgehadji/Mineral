{
  "dataset": "extraction",
  "version": "1.0.0",
  "target": "packages/ingest/src/companyfacts.ts",
  "notes": [
    "Extraction against XBRL. XBRL is the ground truth for a financial figure:",
    "the filer tagged it, the regulator received it, and no model is in the path,",
    "so what is being measured here is whether the concept map and the",
    "precedence rules read back exactly what was tagged.",
    "Every value and accession below is synthetic. None is real SEC data."
  ],
  "minAccuracy": 1.0,
  "cases": [
    {
      "id": "reads-a-duration-concept-with-its-period",
      "expected": [
        {
          "code": "revenue",
          "concept": "Revenues",
          "value": 253400000,
          "unit": "USD",
          "periodStart": "2024-01-01",
          "periodEnd": "2024-12-31"
        }
      ],
      "companyfacts": {
        "facts": {
          "us-gaap": {
            "Revenues": {
              "units": {
                "USD": [
                  {
                    "val": 253400000,
                    "start": "2024-01-01",
                    "end": "2024-12-31",
                    "accn": "0000000000-25-000001",
                    "form": "10-K",
                    "filed": "2025-02-20",
                    "fy": 2024,
                    "fp": "FY"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "reads-an-instant-concept-with-its-as-of-date",
      "expected": [
        {
          "code": "total_assets",
          "concept": "Assets",
          "value": 2600000000,
          "unit": "USD",
          "asOfDate": "2024-12-31"
        }
      ],
      "companyfacts": {
        "facts": {
          "us-gaap": {
            "Assets": {
              "units": {
                "USD": [
                  {
                    "val": 2600000000,
                    "end": "2024-12-31",
                    "accn": "0000000000-25-000001",
                    "form": "10-K",
                    "filed": "2025-02-20"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
