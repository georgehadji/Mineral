{
  "name": "mineral",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "dbmate --migrations-dir packages/db/migrations up",
    "db:down": "dbmate --migrations-dir packages/db/migrations down",
    "check": "pnpm typecheck && pnpm test",
    "resolve": "node packages/db/src/resolve-cli.ts",
    "ingest": "node packages/db/src/ingest-cli.ts",
    "calc": "node packages/db/src/calc-cli.ts",
    "analytics": "uv run --directory services/analytics uvicorn mineral_analytics.api:app --port 8000",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f packages/db/seeds/001-rare-earth-issuers.sql"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
